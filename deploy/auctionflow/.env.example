# Copy to .env on the server and fill in. Never commit the .env file.

# Any long random string: openssl rand -hex 24
POSTGRES_PASSWORD=

# RPC the indexer uses. A private RPC (Alchemy, QuickNode...) is more reliable
# than the public default; a free plan may be too rate-limited to backfill.
RPC_URL=https://sepolia.base.org

# Bump this (auctionflow2, auctionflow3...) to re-index from scratch.
INDEXER_SCHEMA=auctionflow

# Compiled into the browser bundle.
CHAIN_ID=84532
PUBLIC_RPC_URL=
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Pinata JWT for launch images. Leave empty to launch without images.
PINATA_JWT=
