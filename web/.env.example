# Chain the app talks to: 84532 (Base Sepolia) or 8453 (Base).
NEXT_PUBLIC_CHAIN_ID=84532
# RPC the browser uses for reads. Defaults to the chain's public endpoint.
NEXT_PUBLIC_RPC_URL=
# WalletConnect project ID (free at cloud.reown.com). Without it, WalletConnect
# isn't offered; browser wallets and Coinbase Wallet still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Gateway for showing IPFS images and metadata.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Server-only. Where the app's server reaches the indexer's GraphQL API.
INDEXER_URL=http://localhost:42069
# Server-only, optional. The site's public address. Normally worked out from
# each request; set it only if link previews show the wrong domain.
SITE_URL=
# Server-only. Pinata JWT for uploading launch images and metadata to IPFS.
# Without it, tokens launch without an image.
PINATA_JWT=
