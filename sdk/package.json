{
  "name": "auctionflow-sdk",
  "version": "1.0.0",
  "description": "Type-safe TypeScript SDK for the AuctionFlow bonding-curve token auction protocol, built on viem.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "keywords": [
    "auction",
    "bonding-curve",
    "token",
    "defi",
    "ethereum",
    "evm",
    "base",
    "viem",
    "web3",
    "price-discovery"
  ],
  "author": "Sodiq Agunbiade",
  "license": "MIT",
  "homepage": "https://github.com/Sodiq-123/AuctionFlow/tree/main/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sodiq-123/AuctionFlow.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/Sodiq-123/AuctionFlow/issues"
  },
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "viem": "^2.52.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
